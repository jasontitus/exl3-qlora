+//! Construction-time NAX eligibility. Unknown/malformed identities fail closed.
+const std = @import("std");
+const mlx = @import("sdk").mlx;
+const Stream = mlx.mlx_stream;
+pub fn naxFrom(arch: []const u8, version: []const u8) bool {
+    const prefix = "applegpu_g";
+    if (arch.len <= prefix.len or arch.len > 32 or !std.ascii.startsWithIgnoreCase(arch, prefix)) return false;
+    const suffix = arch[prefix.len..];
+    var digits: usize = 0;
+    while (digits < suffix.len and std.ascii.isDigit(suffix[digits])) digits += 1;
+    if (digits == 0 or suffix.len > digits + 1) return false;
+    var phone = false;
+    if (digits < suffix.len) {
+        const kind = std.ascii.toLower(suffix[digits]);
+        if (kind != 'p' and kind != 'g' and kind != 'd' and kind != 's') return false;
+        phone = kind == 'p';
+    }
+    const gen = std.fmt.parseInt(u32, suffix[0..digits], 10) catch return false;
+    if (gen < @as(u32, if (phone) 18 else 17)) return false;
+    var it = std.mem.splitScalar(u8, version, '.');
+    var parts: [3]u32 = .{0,0,0};
+    var count: usize = 0;
+    while (it.next()) |part| {
+        if (count == 3 or part.len == 0) return false;
+        for (part) |ch| if (!std.ascii.isDigit(ch)) return false;
+        parts[count] = std.fmt.parseInt(u32, part, 10) catch return false;
+        count += 1;
+    }
+    if (count < 2) return false;
+    return parts[0] > 26 or (parts[0] == 26 and parts[1] >= 2);
+}
+extern "c" fn sysctlbyname(name: [*:0]const u8, oldp: ?*anyopaque, oldlenp: ?*usize, newp: ?*const anyopaque, newlen: usize) c_int;
+
+/// The stream's device has NAX units (read once, at construction).
+pub fn deviceHasNax(s: Stream) bool {
+    var dev = mlx.mlx_device{ .ctx = null };
+    if (mlx.mlx_stream_get_device(&dev, s) != 0) return false;
+    defer _ = mlx.mlx_device_free(dev);
+    var kind: mlx.mlx_device_type = .cpu;
+    if (mlx.mlx_device_get_type(&kind, dev) != 0 or kind != .gpu) return false;
+    var info = mlx.mlx_device_info_new();
+    defer _ = mlx.mlx_device_info_free(info);
+    if (mlx.mlx_device_info_get(&info, dev) != 0) return false;
+    var cstr: [*:0]const u8 = undefined;
+    if (mlx.mlx_device_info_get_string(&cstr, info, "architecture") != 0) return false;
+    var ver: [64]u8 = undefined;
+    var len: usize = ver.len;
+    if (sysctlbyname("kern.osproductversion", &ver, &len, null, 0) != 0) return false;
+    var n = @min(len, ver.len);
+    while (n > 0 and ver[n - 1] == 0) n -= 1;
+    return naxFrom(std.mem.span(cstr), ver[0..n]);
+}
+
+
+test "strict capability identities" {
+    const t = std.testing;
+    try t.expect(naxFrom("applegpu_g17g", "26.2"));
+    try t.expect(naxFrom("applegpu_g18p", "27.0.1"));
+    for ([_][]const u8{"27.bad", "27.2.junk", "27.2.0.extra", "27", "", "26.1", "26.2."}) |v| try t.expect(!naxFrom("applegpu_g17g", v));
+    for ([_][]const u8{"applegpu_g13g", "applegpu_g17p", "applegpu_g17garbage", "applegpu_g17x", "cpu", "applegpu_g"}) |v| try t.expect(!naxFrom(v, "27.2"));
+}
