+    // Additional pessimistic stock per-head QK/ReLU/weighted chain plus reduced
+    // scores/masks/top-k staging. Existing wave terms remain charged as well.
+    return add(try mul(try mul(try mul(@min(rows,tile_rows),heads),positions),16),try mul(try mul(rows,positions),32));
