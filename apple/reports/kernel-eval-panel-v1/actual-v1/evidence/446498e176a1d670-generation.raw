I'll optimize the kernel by using a single thread per row with vectorized float4 loads and a Kahan-free but numerically safe reduction, keeping the declared ABI and dispatch unchanged.

<｜DSML｜ calls>
<｜DSML｜ invoke name="exec_command">
<｜DSML｜ parameter name="cmd" string="true">git apply --whitespace=nowarn <<'KERNEL_PATCH'
diff --git a/kernel.metal b/kernel.metal
--- a/kernel.metal
+++ b/kernel.metal
@@ -1,5 +1,31 @@
 #include <metal_stdlib>
 using namespace metal;
 kernel void row_sum(device const float* input [[buffer(0)]], device float* output [[buffer(1)]], constant uint& rows [[buffer(2)]], constant uint& cols [[buffer(3)]], uint gid [[thread_position_in_grid]]) {
-const uint row=gid; if(row>=rows)return; float total=0.0f, correction=0.0f; for(uint col=0;col<cols;++col) { float adjusted=max(0.5f * input[row * cols + col] + 0.25f, 0.0f)-correction; float updated=total+adjusted; correction=(updated-total)-adjusted; total=updated; }; output[row]=total;
+const uint row=gid; if(row>=rows)return;
+const device float* rp=input+row*cols;
+float total=0.0f;
+uint col=0;
+const uint cols4=cols&~3u;
+for(;col<cols4;col+=4){
+float4 v=*(const device float4*)(rp+col);
+float4 t=fma(v,0.5f,0.25f);
+t=max(t,0.0f);
+total+=t.x+t.y+t.z+t.w;
+}
+for(;col<cols;++col){
+float t=fma(rp[col],0.5f,0.25f);
+total+=max(t,0.0f);
+}
+output[row]=total;
 }
KERNEL_PATCH</｜DSML｜ parameter>
