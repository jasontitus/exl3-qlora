    }
  ],
  "scope": "Next-round candidate library. Active train/testsets frozen. Source claims are not reproduced measurements.",
  "user_aliases": {
    "squash": "splash"
  },
  "collection_policy": {
    "cadence_hours": 24,
    "lookback": "Incremental new commits plus bounded historical backfill each run; record coverage and gaps",
    "candidate_sources": [
      "commits",
      "merged pull requests",
      "releases",
      "changelogs",
      "primary author announcements"
    ],
    "required_before_training": [
      "paired before/after source",
      "exact source/revision/parent/license provenance",
      "performance claim with workload and hardware or explicit missing evidence",
      "lineage and fork deduplication",
      "protected evaluation overlap check",
      "agent edit replay",
      "compile/correctness evidence or explicit unqualified tier"
    ],
    "auto_promote_to_training": false,
    "gpu_benchmarks_while_training": false
  }
}
